rules_version = '2';

/* 護腎教室 KidneyGod.Studio — Firestore 安全規則
   貼到 Firebase console > Firestore Database > 規則 > 發布。

   原則：
     users       只有本人讀寫自己那份進度，任何人都看不到別人的
     stats/site  任何人可讀（頁尾瀏覽次數），寫入只允許 +1，擋灌水
     leaderboard 任何人可讀，但只能寫「文件 id 開頭等於自己 uid」的那些筆，
                 不能改別人的成績。排行榜每週重來，文件 id 是 {uid}_{週一日期}，
                 一人一週一筆；換週就是新的一筆，上週的留著發獎用。

   名稱是自由欄位（本來就允許取任何綽號），要守住的是分數。以下限制讓
   分數只能用「一輪一輪玩上去」的節奏累積：
     ・只升不降，上限 100
     ・每次寫入最多 +10（一輪十題的上限），不能一次跳到滿分
     ・兩次寫入至少間隔 10 秒，十題不可能在十秒內答完
     ・分數不得超過「已完成輪數 × 10」
   合計：要從零爬到 100 至少得寫入十次、耗時 90 秒以上。

   2026-09-08 這裡曾要改成 200／20 輪，同日決定維持 100／10。
   ⚠ 這兩個數字在 game.html（QUIZ_TOTAL、QUIZ_CHALLENGE）與 sync.js（LB_MAX_*）
     也各有一份，三處必須一致。只改前端不改這裡的話，超過上限的寫入會被
     這份規則拒絕，而前端的 catch 只寫 console.debug——畫面上完全看不出失敗。
   ⚠ **改完這個檔案不會自動生效**：它只是版本控制裡的一份副本，
     要到 Firebase console > Firestore > 規則貼上並發布才算數。

   2026-09-24 09:47 已發布，線上與這份一致（含 newsreview）。實測：
   newsreview 未登入可讀 200、未登入寫入 403；subs 仍不可讀 403；
   review 與 leaderboard 仍可讀 200。
   **下次再改這個檔，記得回來更新這一行，不然它會變成騙人的。**

   ※ 誠實說明：這是提高成本，不是證明。安全規則只看得到單次寫入內容，
     無法驗證題目是否真的答對。要真正保證分數是玩出來的，必須把出題與
     計分搬到伺服器（Cloud Functions，需升級 Blaze 方案）。
*/
service cloud.firestore {
  match /databases/{database}/documents {

    /* ── 個人進度：完全私有 ── */
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    /* ── 站台計數器：公開讀，寫入只能 +1 ── */
    match /stats/site {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['views'])
                    && request.resource.data.views == 1;
      allow update: if request.resource.data.keys().hasOnly(['views'])
                    && request.resource.data.views == resource.data.views + 1;
      allow delete: if false;
    }

    /* ── Email 訂閱名單 ──
       文件 id 就是信箱本身，這一步同時做到三件事：
         1. 同一個信箱只會有一筆，重複送出不會塞滿集合
         2. id 與 email 欄位互相綁定（下面那條 d.email == mail）
         3. 只允許 create、不允許 update，所以重複訂閱會被擋下 ——
            前端收到 403 就顯示「已經訂閱過了」，那是正確結果不是錯誤

       **一律不可公開讀取**：這是個資，外洩等於把讀者的信箱送給爬蟲。
       只有站長本人（用 Google 登入）讀得到，給後台頁面匯出名單用。
       刪除也只有站長能做（要能處理退訂）。 */
    function owner() {
      return request.auth != null && request.auth.token.email == 'a778040@gmail.com';
    }
    match /subs/{mail} {
      function valid() {
        let d = request.resource.data;
        return d.keys().hasOnly(['email', 'src', 'at'])
            && d.email is string && d.email == mail
            && mail.size() <= 120
            && mail.matches('^[^@]+@[^@]+[.][^@]+$')
            && d.src is string && d.src.size() <= 60
            && d.at is timestamp;
      }
      allow create: if valid();
      allow update: if false;          // 重複訂閱擋在這裡
      allow read, delete: if owner();  // 匯出名單與處理退訂
    }

    /* ── 醫師審閱紀錄 ──
       作者在後台頁面按一下就寫一筆，之後 sync_reviews.py 抓回
       articles_src/reviewed.json 再重新建站。醫院擋 Telegram，但擋不住網頁。
       日期本來就會publish在網站上，所以公開讀沒有問題；寫入只有本人可以。 */
    match /review/{page} {
      allow read: if true;
      /* path 一起存起來：文件 id 不能有斜線，所以 id 是把 / 換成 __ 的版本。
         把原始路徑放在欄位裡，同步腳本就不必反推，少一個會對不起來的地方。 */
      allow write: if owner()
                   && request.resource.data.keys().hasOnly(['path', 'date', 'at'])
                   && request.resource.data.path is string
                   && request.resource.data.path.size() <= 120
                   && request.resource.data.date is string
                   && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    /* ── 每日新知的逐篇醫師確認 ──
       分類頁不掛審閱日期（內容每天自動長出來），但每一篇研究摘要本身寫好
       之後就不會再變，所以確認的單位是「篇」不是「頁」。
       作者在後台按一下寫一筆，sync_reviews.py 抓回 news_reviewed.json。

       文件 id 是 DOI 把斜線換成 __ 的版本（id 不能含斜線）；
       原始 DOI 放在欄位裡，同步腳本就不必反推。
       日期本來就會顯示在頁面上，公開讀沒問題；寫入只有本人可以。 */
    match /newsreview/{docId} {
      allow read: if true;
      allow write: if owner()
                   && request.resource.data.keys().hasOnly(['doi', 'date', 'at'])
                   && request.resource.data.doi is string
                   && request.resource.data.doi.size() <= 120
                   && request.resource.data.date is string
                   && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    /* ── 每題作答統計：聚合數字，不含任何身分 ──
       只記「第 N 題被作答幾次、答對幾次」，回推不到個人，也不影響排行榜。
       分成 s0–s3 數份，避免單一文件的每秒一次寫入上限在尖峰塞車。
       ※ 規則無法驗證增量是不是真的玩出來的 —— 這份資料只當選題參考。 */
    match /qstats/{shard} {
      allow read:           if request.auth != null;
      allow create, update: if request.auth != null && shard.matches('^s[0-3]$');
      allow delete:         if false;
    }

    /* ── 小學堂排行榜：公開讀，一人「一週」一筆 ── */
    match /leaderboard/{docId} {
      function mine() {
        return request.auth != null
            && docId.matches('^' + request.auth.uid + '_[0-9]{8}$');
      }
      function valid() {
        let d = request.resource.data;
        return d.keys().hasOnly(['uid', 'week', 'name', 'score', 'rounds', 'at'])
            && d.uid == request.auth.uid
            && d.week is string && d.week.matches('^[0-9]{8}$')
            && d.name is string && d.name.size() > 0 && d.name.size() <= 16
            && d.score is int  && d.score  >= 0 && d.score  <= 100
            && d.rounds is int && d.rounds >= 1 && d.rounds <= 10
            && d.score <= d.rounds * 10        // 一輪十題，分數不能超過已玩輪數
            && d.at == request.time;           // 時間戳必須由伺服器產生
      }
      allow read:   if true;
      allow create: if mine() && valid();
      allow update: if mine() && valid()
                    && request.resource.data.week == resource.data.week
                    && request.resource.data.score > resource.data.score
                    && request.resource.data.score <= resource.data.score + 10
                    && request.time > resource.data.at + duration.value(10, 's');
      /* 讓「刪除雲端資料」也能把自己的成績下架 */
      allow delete: if mine();
    }
  }
}
